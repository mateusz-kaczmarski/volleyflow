{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "volleyflow": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "vf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/public"],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }], "outputHashing": "all" }
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "volleyflow:build:production" }, "development": { "buildTarget": "volleyflow:build" } }, "defaultConfiguration": "development" }
      }
    }
  },
  "cli": {
    "analytics": "b6d6471b-28e8-43e3-a3af-91ea7eb4a805"
  }
}
